<?xml version="1.0" encoding="utf-8"?>
<resources>

    <color name="weimo_paper">#F3EFE7</color>
    <color name="weimo_ink">#1B1E1C</color>
    <color name="weimo_ink_deep">#111411</color>
    <color name="weimo_cinnabar">#9E3F32</color>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/weimo_ink</item>
        <item name="colorPrimaryDark">@color/weimo_ink_deep</item>
        <item name="colorAccent">@color/weimo_cinnabar</item>
        <item name="android:statusBarColor">@color/weimo_ink_deep</item>
        <item name="android:navigationBarColor">@color/weimo_paper</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/weimo_ink</item>
        <item name="colorPrimaryDark">@color/weimo_ink_deep</item>
        <item name="colorAccent">@color/weimo_cinnabar</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/weimo_ink_deep</item>
        <item name="android:navigationBarColor">@color/weimo_paper</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/weimo_paper</item>
        <item name="android:statusBarColor">@color/weimo_ink_deep</item>
        <item name="android:navigationBarColor">@color/weimo_paper</item>
    </style>
</resources>
